# IRONPULSE — Environment Variables
# Copy to .env and fill in your values
# These values are public-facing Firebase config (safe to commit as template)

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# Referral System — app base URL for shareable referral links
VITE_APP_URL=https://your-domain.com

# Pulse AI — Google Gemini (optional fallback provider)
# Leave empty to keep the assistant on simulated/local answers.
# Sent to Gemini: question, role, last 10 chat turns — plus, for
# supported analysis requests (e.g. "Analyze my progress"), an
# explicit minimal slice of metrics (weight, body fat, goal).
# The full AppContext is never sent.
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.0-flash
