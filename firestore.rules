rules_version = '2';

// ══════════════════════════════════════════════════════════
//  IRONPULSE — Firestore Security Rules
//  Roles: super_admin | gym_admin | trainer | member | pending | gym_owner_pending
//  Legacy aliases: admin + isSuperAdmin → super_admin, gym_owner → gym_admin
// ══════════════════════════════════════════════════════════

service cloud.firestore {

  match /databases/{database}/documents {

    // ── HELPERS ───────────────────────────────────────────

    function getRole() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userPath) ? get(userPath).data.role : null;
    }

    function isAuthed() {
      return request.auth != null;
    }

    // Super admin: admin role with isSuperAdmin flag on user doc
    function isSuperAdmin() {
      return isAuthed() && (
        getRole() == 'super_admin' ||
        (getRole() == 'admin' &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSuperAdmin == true)
      );
    }

    // Gym-level admin: gym_admin role OR gym_owner role OR legacy admin (non-super)
    function isGymAdmin() {
      return isAuthed() && (
        getRole() == 'gym_admin' ||
        getRole() == 'gym_owner' ||
        (getRole() == 'admin' &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSuperAdmin != true)
      );
    }

    function isTrainer() {
      return isAuthed() && getRole() == 'trainer';
    }

    function isMember() {
      return isAuthed() && getRole() == 'member';
    }

    // Platform staff: super admin or gym admin
    function isAdminOrOwner() {
      return isSuperAdmin() || isGymAdmin();
    }

    // Staff: anyone managing the gym (super admin, gym admin, trainer)
    function isStaff() {
      return isSuperAdmin() || isGymAdmin() || isTrainer();
    }

    // Approved users who can read plans etc.
    function isApproved() {
      return isAuthed() && (
        getRole() == 'super_admin' ||
        getRole() == 'gym_admin' ||
        getRole() == 'gym_owner' ||
        getRole() == 'trainer' ||
        getRole() == 'member' ||
        (getRole() == 'admin')
      );
    }

    function getCallerGymId() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userPath) ? get(userPath).data.gymId : null;
    }

    function isOwnAttendance(resourceMemberId) {
      return isMember() && resourceMemberId == request.auth.uid;
    }

    function isOwnMemberDoc(resourceMemberId) {
      let memberPath = /databases/$(database)/documents/members/$(resourceMemberId);
      return isMember() &&
        exists(memberPath) &&
        get(memberPath).data.authUid == request.auth.uid;
    }

    // Helper: check if the resource belongs to the caller's gym (super_admin bypasses)
    // Null-safe: non-existent docs (resource == null) are denied here, 
    // so callers must handle them via doc ID prefix checks where applicable.
    function inCallersGym() {
      return isSuperAdmin() || (
        resource != null && resource.data != null && resource.data.gymId == getCallerGymId()
      );
    }

    // Helper: check if the incoming data belongs to the caller's gym (for create)
    function inCallersGymCreate() {
      return isSuperAdmin() || (
        request.resource != null && request.resource.data != null &&
        request.resource.data.gymId == getCallerGymId()
      );
    }

    // ════════════════════════════════════════════════════════
    //  USERS
    // ════════════════════════════════════════════════════════
    match /users/{uid} {

      allow read: if isAuthed() && (
        request.auth.uid == uid || isStaff()
      );

      allow create: if (isAuthed() && request.auth.uid == uid) || isStaff();

      allow update: if isAuthed() && (
        (request.auth.uid == uid &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.referralCode == resource.data.referralCode &&
          request.resource.data.referredBy == resource.data.referredBy)
        || (isStaff() &&
          request.resource.data.referralCode == resource.data.referralCode &&
          request.resource.data.referredBy == resource.data.referredBy)
      );

      allow delete: if isSuperAdmin();
    }

    // ════════════════════════════════════════════════════════
    //  MEMBERS (gym-scoped)
    // ════════════════════════════════════════════════════════
    match /members/{memberId} {

      allow read: if (isStaff() && inCallersGym()) || (
        isMember() &&
        resource.data.authUid == request.auth.uid
      );

      allow create: if isAdminOrOwner() && inCallersGymCreate();
      allow update: if (isAdminOrOwner() && inCallersGym()) || (
        isTrainer() && inCallersGym() &&
        request.resource.data.amountPaid == resource.data.amountPaid &&
        request.resource.data.planPrice == resource.data.planPrice
      );
      allow delete: if isAdminOrOwner() && inCallersGym();
    }

    // ════════════════════════════════════════════════════════
    //  TRAINERS (gym-scoped)
    // ════════════════════════════════════════════════════════
    match /trainers/{trainerId} {

      allow read: if isStaff() && inCallersGym();
      allow create: if isAdminOrOwner() && inCallersGymCreate();
      allow update: if isAdminOrOwner() && inCallersGym();
      allow delete: if isAdminOrOwner() && inCallersGym();
    }

    // ════════════════════════════════════════════════════════
    //  PAYMENTS (gym-scoped)
    // ════════════════════════════════════════════════════════
    match /payments/{paymentId} {

      allow read: if (isAdminOrOwner() && inCallersGym()) || (
        resource.data.gymId == getCallerGymId() && (
          isOwnMemberDoc(resource.data.memberId) ||
          (isMember() && resource.data.authUid == request.auth.uid)
        )
      );
      allow create: if isAdminOrOwner() && inCallersGymCreate();
      allow update: if isAdminOrOwner() && inCallersGym();
      allow delete: if isAdminOrOwner() && inCallersGym();
    }

    // ════════════════════════════════════════════════════════
    //  ATTENDANCE (gym-scoped)
    // ════════════════════════════════════════════════════════
    match /attendance/{attendanceId} {

      allow read: if (isStaff() && inCallersGym()) || isOwnAttendance(resource.data.memberId);
      allow create: if (isStaff() && inCallersGymCreate()) || (
        isMember() &&
        isOwnAttendance(request.resource.data.memberId)
      );
      allow update: if isAdminOrOwner() && inCallersGym();
      allow delete: if isAdminOrOwner() && inCallersGym();
    }

    // ════════════════════════════════════════════════════════
    //  PLANS (gym-scoped — membership pricing)
    // ════════════════════════════════════════════════════════
    match /plans/{planId} {

      allow read: if isApproved() && inCallersGym();
      allow create: if (isSuperAdmin() || isGymAdmin()) && inCallersGymCreate();
      allow update: if (isSuperAdmin() || isGymAdmin()) && inCallersGym();
      allow delete: if (isSuperAdmin() || isGymAdmin()) && inCallersGym();
    }

    // ════════════════════════════════════════════════════════
    //  DIET PLANS (gym-scoped)
    // ════════════════════════════════════════════════════════
    match /dietPlans/{planId} {

      allow read: if (isStaff() && inCallersGym()) || (
        isMember() &&
        (resource.data.memberId == request.auth.uid ||
         resource.data.authUid == request.auth.uid)
      );
      allow create: if isStaff() && inCallersGymCreate();
      allow update: if isStaff() && inCallersGym();
      allow delete: if isAdminOrOwner() && inCallersGym();
    }

    // ════════════════════════════════════════════════════════
    //  WORKOUT PLANS (gym-scoped)
    // ════════════════════════════════════════════════════════
    match /workoutPlans/{planId} {

      allow read: if (isStaff() && inCallersGym()) || (
        isMember() &&
        (resource.data.memberId == request.auth.uid ||
         resource.data.authUid == request.auth.uid)
      );
      allow create: if isStaff() && inCallersGymCreate();
      allow update: if isStaff() && inCallersGym();
      allow delete: if isAdminOrOwner() && inCallersGym();
    }

    // ════════════════════════════════════════════════════════
    //  PROGRESS LOGS (gym-scoped)
    // ════════════════════════════════════════════════════════
    match /progressLogs/{logId} {

      allow read: if (isStaff() && inCallersGym()) || isOwnMemberDoc(resource.data.memberId);
      allow create: if (isStaff() && inCallersGymCreate()) || (
        isMember() &&
        isOwnMemberDoc(request.resource.data.memberId)
      );
      allow update: if isAdminOrOwner() && inCallersGym();
      allow delete: if isAdminOrOwner() && inCallersGym();
    }

    // ════════════════════════════════════════════════════════
    //  SUPPORT TICKETS (gym-scoped)
    // ════════════════════════════════════════════════════════
    match /supportTickets/{ticketId} {

      allow read: if (isAdminOrOwner() && inCallersGym()) || (
        isAuthed() && resource.data.createdBy == request.auth.uid
      );
      allow create: if isAuthed() && inCallersGymCreate();
      allow update: if isAdminOrOwner() && inCallersGym();
      allow delete: if isAdminOrOwner() && inCallersGym();
    }

    // ════════════════════════════════════════════════════════
    //  FEATURE REQUESTS (gym-scoped)
    // ════════════════════════════════════════════════════════
    match /featureRequests/{requestId} {

      allow read: if (isAdminOrOwner() && inCallersGym()) || (
        isAuthed() && resource.data.createdBy == request.auth.uid
      );
      allow create: if isAuthed() && inCallersGymCreate();
      allow update: if isAdminOrOwner() && inCallersGym();
      allow delete: if isAdminOrOwner() && inCallersGym();
    }

    // ════════════════════════════════════════════════════════
    //  SETTINGS (gym-scoped via composite key pattern)
    //  Doc IDs use pattern: `${gymId}:${docId}` (e.g. "default:theme")
    //  Global docs (no prefix): "billing"
    // ════════════════════════════════════════════════════════
    match /settings/{docId} {

      // Helper: check doc ID prefix or data field for gym ownership
      // Single-expression form (CEL restrictions: no if/return in functions).
      function inSettingsGym() {
        return isSuperAdmin() ||
          (resource != null && resource.data != null && resource.data.gymId == getCallerGymId()) ||
          (getCallerGymId() != null && docId.matches('^' + getCallerGymId() + ':'));
      }

      allow read: if (isAdminOrOwner() && inSettingsGym()) || (
        isApproved() && (
          isSuperAdmin() ||
          docId == getCallerGymId() + ':gym' ||
          docId == getCallerGymId() + ':theme' ||
          docId == 'gym' || docId == 'theme' ||
          docId == 'referralSettings'
        )
      );
      allow create: if isAdminOrOwner() && inCallersGymCreate();
      allow update: if isSuperAdmin() || (isAdminOrOwner() && inCallersGym());
      allow delete: if isSuperAdmin();
    }

    // ════════════════════════════════════════════════════════
    //  GYMS (global — multi-tenant registry)
    // ════════════════════════════════════════════════════════
    match /gyms/{gymId} {

      allow read: if isStaff();
      allow create: if isSuperAdmin() || (
        isAuthed() &&
        request.resource.data.ownerUid == request.auth.uid
      );
      allow update: if isAdminOrOwner() && inCallersGym();
      allow delete: if isSuperAdmin();
    }

    // ════════════════════════════════════════════════════════
    //  SUBSCRIPTIONS (global — billing per gym)
    // ════════════════════════════════════════════════════════
    match /subscriptions/{subId} {

      allow read: if isAdminOrOwner() && inCallersGym();
      allow create: if isAdminOrOwner() && inCallersGymCreate();
      allow update: if isAdminOrOwner() && inCallersGym();
      allow delete: if isSuperAdmin();
    }

    // ════════════════════════════════════════════════════════
    //  SUBSCRIPTION HISTORY (gym-scoped)
    // ════════════════════════════════════════════════════════
    match /subscriptionHistory/{historyId} {

      allow read: if isAdminOrOwner() && inCallersGym();
      allow create: if isAdminOrOwner() && inCallersGymCreate();
      allow delete: if isSuperAdmin();
    }

    // ════════════════════════════════════════════════════════
    //  PAYMENT ATTEMPTS (PhonePe integration, gym-scoped)
    // ════════════════════════════════════════════════════════
    match /paymentAttempts/{attemptId} {

      allow read: if isAdminOrOwner() && inCallersGym();
      allow create: if isAdminOrOwner() && inCallersGymCreate();
      allow update: if isAdminOrOwner() && inCallersGym();
      allow delete: if isSuperAdmin();
    }

    // ════════════════════════════════════════════════════════
    //  LICENSED DEVICES (gym-scoped — device registry)
    // ════════════════════════════════════════════════════════
    match /licensedDevices/{deviceId} {

      allow read: if isSuperAdmin() || (
        isGymAdmin() && resource.data.gymId == getCallerGymId()
      );

      allow create: if isAdminOrOwner() && (
        isSuperAdmin() || request.resource.data.gymId == getCallerGymId()
      );

      allow update: if isSuperAdmin() || (
        isGymAdmin() && resource.data.gymId == getCallerGymId()
      );

      allow delete: if isSuperAdmin() || (
        isGymAdmin() && resource.data.gymId == getCallerGymId()
      );
    }

    // ════════════════════════════════════════════════════════
    //  LICENSE HISTORY (gym-scoped — audit log)
    // ════════════════════════════════════════════════════════
    match /licenseHistory/{historyId} {

      allow read: if isSuperAdmin() || (
        isGymAdmin() && resource.data.gymId == getCallerGymId()
      );

      allow create: if isStaff();

      allow update: if isSuperAdmin();

      allow delete: if isSuperAdmin();
    }

    // ════════════════════════════════════════════════════════
    //  CONTACT MESSAGES (Landing page — unauthenticated create)
    // ════════════════════════════════════════════════════════
    match /contactMessages/{msgId} {

      allow create: if true; // anyone can submit a contact form

      allow read, update, delete: if isSuperAdmin();
    }

    // ════════════════════════════════════════════════════════
    //  REFERRALS (gym-scoped)
    //  Members: read own referrals (as referrer)
    //  Gym admins: read gym referrals
    //  Super admin: full access
    // ════════════════════════════════════════════════════════
    match /referrals/{referralId} {

      allow read: if isSuperAdmin() || (
        isGymAdmin() && resource.data.gymId == getCallerGymId()
      ) || (
        isMember() && resource.data.referrerUid == request.auth.uid
      );

      allow create: if isSuperAdmin() || (
        isGymAdmin() && inCallersGymCreate()
      );

      allow update: if isSuperAdmin() || (
        isGymAdmin() && resource.data.gymId == getCallerGymId()
      );

      allow delete: if isSuperAdmin();
    }

    // ════════════════════════════════════════════════════════
    //  REFERRAL SETTINGS (single global doc in /settings)
    //  Super admin: full access
    //  Gym admin: read only
    // ════════════════════════════════════════════════════════
    // ════════════════════════════════════════════════════════
    //  REWARD LEDGER (gym-scoped — referral rewards)
    //  Members: read own reward records
    //  Gym admins: read gym reward records
    //  Super admin: full access
    // ════════════════════════════════════════════════════════
    match /rewardLedger/{rewardId} {

      allow read: if isSuperAdmin() || (
        isGymAdmin() && resource.data.gymId == getCallerGymId()
      ) || (
        isMember() && resource.data.referrerUid == request.auth.uid
      ) || (
        isMember() && resource.data.referredUid == request.auth.uid
      );

      allow create: if isSuperAdmin() || (isGymAdmin() && inCallersGymCreate());
      allow update: if isSuperAdmin() || (isGymAdmin() && resource.data.gymId == getCallerGymId());
      allow delete: if isSuperAdmin();
    }

    // ════════════════════════════════════════════════════════
    //  DISCOUNT COUPONS (gym-scoped — referral discounts)
    //  Members: read own coupons
    //  Gym admins: read gym coupons
    //  Super admin: full access
    // ════════════════════════════════════════════════════════
    match /discountCoupons/{couponId} {

      allow read: if isSuperAdmin() || (
        isGymAdmin() && resource.data.gymId == getCallerGymId()
      ) || (
        isMember() && resource.data.userId == request.auth.uid
      );

      allow create: if isSuperAdmin() || (isGymAdmin() && inCallersGymCreate());
      allow update: if isSuperAdmin() || (isGymAdmin() && resource.data.gymId == getCallerGymId());
      allow delete: if isSuperAdmin();
    }

    // ════════════════════════════════════════════════════════
    //  REFERRAL AUDIT LOGS (super admin only — referral events)
    // ════════════════════════════════════════════════════════
    match /referralAuditLogs/{logId} {

      allow read: if isSuperAdmin() || (
        isGymAdmin() && resource.data.gymId == getCallerGymId()
      );

      allow create: if isAuthed();

      allow update, delete: if isSuperAdmin();
    }

    // ════════════════════════════════════════════════════════
    //  AUDIT LOG (super admin only — sensitive changes)
    // ════════════════════════════════════════════════════════
    match /auditLog/{logId} {

      allow read: if isSuperAdmin();
      allow create: if isAuthed() && (
        isSuperAdmin() || isGymAdmin()
      );
      allow update, delete: if isSuperAdmin();
    }

    // ════════════════════════════════════════════════════════
    //  NOTIFICATIONS (user-scoped with gymId field)
    // ════════════════════════════════════════════════════════
    match /notifications/{notifId} {

      allow read: if isSuperAdmin() || (
        isAuthed() &&
        resource.data.userId == request.auth.uid
      );

      allow create: if isAuthed() && (
        isSuperAdmin() || isGymAdmin() || (
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.gymId == getCallerGymId()
        )
      ) || (
        !isAuthed() &&
        request.resource.data.targetRole == 'super_admin' &&
        request.resource.data.type == 'contact'
      );

      allow update: if isSuperAdmin() || (
        isAuthed() &&
        resource.data.userId == request.auth.uid &&
        resource.data.gymId == getCallerGymId()
      );

      allow delete: if isSuperAdmin() || (
        isAuthed() &&
        resource.data.userId == request.auth.uid &&
        resource.data.gymId == getCallerGymId()
      );
    }

  } // end match /databases/{database}/documents
} // end service cloud.firestore
