# IRONPULSE — Production Environment Variables
# Copy to .env.production and fill in your values

# App base URL — used for shareable referral links AND Supabase Auth email
# action links (email verification, password reset). Must match a domain
# listed in Supabase Dashboard > Authentication > URL Configuration.
VITE_APP_URL=https://your-domain.com

# Pulse AI — Groq (optional AI provider; OpenAI-compatible API)
# Leave empty to keep the assistant on deterministic/local answers.
# Sent to Groq: question, role, last 10 chat turns — plus, for
# supported analysis requests (e.g. "Analyze my progress"), an
# explicit minimal slice of metrics (weight, body fat, goal).
# The full AppContext is never sent, and the key is never logged.
VITE_GROQ_API_KEY=
VITE_GROQ_MODEL=llama-3.3-70b-versatile

# Cashfree Payment Gateway (optional — membership & subscription payments)
# mode: 'sandbox' (default) | 'production' — lowercase only (no quotes).
# The app id / client id are PUBLIC SDK credentials required only to load
# the Cashfree checkout SDK in the browser (they are NOT secrets).
# The app id / client id are the SAME PUBLIC Cashfree credential (the App ID
# is the public client identifier sent as x-client-id). Both env names are
# accepted aliases; set either one. They are NOT secrets.
# The secret key is NEVER present in the browser: it lives only in Supabase
# Edge Function secrets (CASHFREE_CLIENT_SECRET), which create orders /
# verify payments / handle webhooks server-side.
# IMPORTANT: the id value must come from the MERCHANT's own Cashfree
# account (Cashfree Dashboard > Settings > API Keys). Without a real id the
# checkout stays on the PhonePe fallback — there is no default/dummy value
# to invent.
VITE_CASHFREE_MODE=sandbox
VITE_CASHFREE_APP_ID=
VITE_CASHFREE_CLIENT_ID=

# Auth backend: 'supabase' (default) | 'firebase' (legacy rollback, rebuild-only)
# 'supabase' - Supabase Auth (GoTrue) is the identity backend: sessions,
#   sign-in, email verification, password reset/recovery. Profiles come from
#   the Supabase 'profiles' table. firestoreService reads/writes the Supabase
#   data plane with the same call contracts as Firestore.
# 'firebase' - legacy rollback only. There is NO automatic/silent fallback.
#   IMPORTANT: VITE_AUTH_PROVIDER must be identical in BOTH authService and
#   firestoreService builds or backends mix (empty screens).
VITE_AUTH_PROVIDER=supabase

# Supabase (active data plane: auth, tables, storage, Edge Functions).
# URL + publishable (anon) key from Supabase Dashboard > Project Settings > API.
# The service-role key is NEVER a VITE_ var - it lives only server-side
# (migrations / Edge Functions).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
